# Browser-safe. The anon key is protected by RLS, which is enforced in the
# database (supabase/migrations/..._rls_policies.sql), not by hiding this value.
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Set locally to show the one-click demo sign-in panel. Leave it unset in any
# deployed environment: without it the panel is gone and the shared password is
# not in the bundle at all.
VITE_DEMO_PASSWORD=demo123
