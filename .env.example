# Browser-safe. The anon key is protected by RLS, which is enforced in the
# database (supabase/migrations/..._rls_policies.sql), not by hiding this value.
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Set locally to show the one-click demo sign-in panel. Leave it unset in any
# deployed environment: without it the panel is gone and the shared password is
# not in the bundle at all.
VITE_DEMO_PASSWORD=demo123

# Edge-function secret, NOT a Vite var. Set it on Supabase, not in this file:
#   supabase secrets set SITE_URL=...
# Base URL used to build guest sign-in / magic links (invite-guest function).
# Unset, it falls back to http://localhost:5173 and the links you send guests
# will not open on their phone.
#
# TEMPORARY — this is the Vercel demo deployment. REPLACE with the real
# production domain once the CRM has one, and add it to
# Supabase → Authentication → URL Configuration → Redirect URLs.
SITE_URL=https://sanctuary-crm-one.vercel.app
